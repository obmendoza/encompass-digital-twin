FROM node:22-slim AS base
RUN corepack enable && corepack prepare pnpm@9.9.0 --activate
WORKDIR /app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./
COPY packages/core/package.json packages/core/tsconfig.json packages/core/
COPY packages/fixtures/package.json packages/fixtures/tsconfig.json packages/fixtures/
COPY packages/api/package.json packages/api/tsconfig.json packages/api/

RUN pnpm install --frozen-lockfile

COPY packages/core/src packages/core/src
COPY packages/fixtures/src packages/fixtures/src
COPY packages/api/src packages/api/src

RUN pnpm -F @twin/core build && pnpm -F @twin/fixtures build

EXPOSE 4000
ENV PORT=4000
CMD ["pnpm", "--filter", "@twin/api", "exec", "tsx", "src/server.ts"]
